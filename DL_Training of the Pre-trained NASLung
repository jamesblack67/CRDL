# Data augmentation (3D)
def augment_3d(img):
    """
    img: Tensor [B, 1, D, H, W] or [1, 1, D, H, W]
    3D medical patch augmentation, including:
        - random flipping
        - random rotation (90°)
        - random intensity perturbation (brightness/contrast)
        - gamma correction
        - random Gaussian noise
        - random scaling + resize back to original size
    """

    # ----------- Basic information -----------
    orig_size = img.shape[-3:]     # D, H, W
    device = img.device

    # ============ 1. Random flipping ============
    if random.random() < 0.5:
        img = torch.flip(img, dims=[-1])  # flip W
    if random.random() < 0.5:
        img = torch.flip(img, dims=[-2])  # flip H
    if random.random() < 0.5:
        img = torch.flip(img, dims=[-3])  # flip D

    # ============ 2. Random 90° rotation ============
    if random.random() < 0.5:
        k = random.randint(1, 3)
        img = torch.rot90(img, k, dims=[-1, -2])  # rotate in H,W plane

    # ============ 3. Random intensity perturbation ============
    if random.random() < 0.3:
        # brightness: ±10%
        factor = 1.0 + 0.1 * (2 * random.random() - 1)
        img = img * factor

    if random.random() < 0.3:
        # contrast: ±10%
        mean = img.mean()
        img = (img - mean) * (1 + 0.1 * (2 * random.random() - 1)) + mean

    # ============ 4. Gamma correction ============
    if random.random() < 0.3:
        gamma = random.uniform(0.7, 1.5)
        img = torch.clamp(img, min=0)
        img = img ** gamma

    # ============ 5. Gaussian noise ============
    if random.random() < 0.4:
        noise = torch.randn_like(img) * 0.03
        img = img + noise

    # ============ 6. Random zoom (scaling) ============
    if random.random() < 0.4:
        scale = random.uniform(0.9, 1.1)
        new_size = [int(s * scale) for s in orig_size]

        # scale
        img = F.interpolate(img, size=new_size, mode='trilinear', align_corners=False)

        # resize back to original size
        img = F.interpolate(img, size=orig_size, mode='trilinear', align_corners=False)

    # Final clip to avoid extreme values
    img = torch.clamp(img, -1000, 2000)

    return img


#
def collect_pairs(root, label):
    pairs = []
    for dirpath, _, files in os.walk(root):
        for f in files:
            if f.endswith(('image.nii', 'image.nii.gz')):
                img_path = os.path.join(dirpath, f)
                if f.endswith('image.nii.gz'):
                    mask_path = img_path.replace('image.nii.gz', 'mask.nii.gz')
                else:
                    mask_path = img_path.replace('image.nii', 'mask.nii')
                if os.path.exists(mask_path):
                    pairs.append({'image': img_path, 'mask': mask_path, 'label': label})
                else:
                    print(f"[WARN] mask not found: {mask_path}")
    return pairs

def load_module(path):
    checkpoint = torch.load(path)
    net = checkpoint['net']
    net.cuda()
    return net

#Model Inference test
def evaluate(net, loader):  #可以复用test_loader / all_loader
    net.eval()
    preds, labels, probs = [], [], []

    with torch.no_grad():
        for img, label, ids in loader:
            label = label.cuda()

            logits = net(img)
            if isinstance(logits, tuple):
                logits = logits[0]

            prob = torch.softmax(logits, dim=1)
            _, pred = torch.max(prob, dim=1)
            preds.extend(pred.cpu().numpy())
            labels.extend(label.cpu().numpy())
            probs.extend(prob[:, 1].cpu().numpy())

    # 
    acc = accuracy_score(labels, preds)
    try:# 二分类 AUC
        auc = roc_auc_score(labels, probs)
    except:
        auc = 0.5
    f1 = f1_score(labels, preds, average='binary')
    cm = confusion_matrix(labels, preds, labels=[0, 1])
    return acc, auc, f1, cm

# 
def partial_freeze(net):

    for p in net.parameters():
        p.requires_grad = True
    if hasattr(net, "conv1"):
        for p in net.conv1.parameters():
            p.requires_grad = False
    # if hasattr(net, "conv2"):
    #     for p in net.conv2.parameters():
    #         p.requires_grad = False
    print("🔒 The conv1 layer has been frozen, and all subsequent layers remain trainable.")


#Train model
def train(net,train_loader,test_loader,num_epochs =100,patience = 15):
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.Adam(  
        filter(lambda p: p.requires_grad, net.parameters()),
        lr=1e-4
    )
    partial_freeze(net)

    best_auc = 0
    bad_epochs = 0
    for epoch in range(num_epochs):
        net.train()
        epoch_loss = 0
        for img, label, _ in train_loader:
            label = label.cuda()

            # Data Augmentation
            img = augment_3d(img)

            out = net(img)
            out = out[0] if isinstance(out, tuple) else out
            loss = criterion(out, label)

            optimizer.zero_grad()
            loss.backward()
            optimizer.step()

            epoch_loss += loss.item()

        # 
        acc, auc, f1, cm = evaluate(net, test_loader)
        if epoch % 5 == 0:
            print(f"\nEpoch [{epoch}/{num_epochs}] "
                  f"Loss: {epoch_loss / len(train_loader):.4f} | "
                  f"ACC: {acc:.4f} | AUC: {auc:.4f} | F1: {f1:.4f}")

        # ========== Early Stop ==========
        if auc > best_auc:
            best_auc = auc
            bad_epochs = 0
            # save model
            torch.save(
                {
                    "net": net,
                    "epoch": epoch,
                    "auc": auc
                },
                "finetuned_best_ckpt.t7"
            )
            # print("👍 find better model，save as best_model.pth")
        else:
            bad_epochs += 1
            if bad_epochs >= patience:
                print(f"AUC has been continuously decreasing — Early Stop triggered! Stopped at epoch {epoch}.")
                break

    print("finish！best AUC =", best_auc)
    print("Confusion Matrix:\n", cm)
    return net


