eval_model("Radiomics", radiomics_model, Xr_test)
eval_model("DL", res_model, Xd_test)

eval_model("CR", cr_model, cr_test)
eval_model("CD", cd_model, cd_test)
eval_model("RDL", rdl_model, rdl_test)
eval_model("CRDL", crdl_model, crdl_test)

