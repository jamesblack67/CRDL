cd_test   = fusion("CD",   p_clinic_test, p_rad_test, p_res_test)
rdl_test  = fusion("RDL",  p_clinic_test, p_rad_test, p_res_test)
crdl_test = fusion("CRDL", p_clinic_test, p_rad_test, p_res_test)

