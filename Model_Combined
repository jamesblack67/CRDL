def train_meta(X_train, y_train, name):
    model = RandomForestClassifier(
        n_estimators=200,
        max_depth=3,
        class_weight='balanced',
        max_features='sqrt',
        min_samples_split=6,
        random_state=SEED,
        n_jobs=-1
    )

    model.fit(X_train, y_train)
    auc_train = roc_auc_score(y_train, model.predict_proba(X_train)[:, 1])
    print(f"{name} 融合模型训练完毕 ✅ 训练AUC = {auc_train:.4f}")

    return model

cr_model   = train_meta(cr_train,   y_train, "CR")
cd_model   = train_meta(cd_train,   y_train, "CD")
rdl_model  = train_meta(rdl_train,  y_train, "RDL（Radiomics+DL）")
crdl_model = train_meta(crdl_train, y_train, "CRDL")

