def fusion(strategy, pc, pr, pd):
    if strategy == "CR":
        return np.column_stack((pc, pr))
    elif strategy == "CD":
        return np.column_stack((pc, pd))
    elif strategy == "RDL":
        return np.column_stack((pr, pd))
    elif strategy == "CRDL":
        return np.column_stack((pc, pr, pd))
    else:
        raise ValueError("未知融合策略")

# 训练集
cr_train   = fusion("CR",   p_clinic_train, p_rad_train, p_res_train)
cd_train   = fusion("CD",   p_clinic_train, p_rad_train, p_res_train)
rdl_train  = fusion("RDL",  p_clinic_train, p_rad_train, p_res_train)
crdl_train = fusion("CRDL", p_clinic_train, p_rad_train, p_res_train)

