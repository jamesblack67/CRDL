def load_dataset(pos_train, neg_train, pos_test, neg_test):
    train_pos = pd.read_csv(pos_train)
    train_neg = pd.read_csv(neg_train)
    test_pos  = pd.read_csv(pos_test)
    test_neg  = pd.read_csv(neg_test)

    train_pos["label"] = 1
    train_neg["label"] = 0
    test_pos["label"] = 1
    test_neg["label"] = 0

    train_df = pd.concat([train_pos, train_neg], axis=0, ignore_index=True)
    test_df  = pd.concat([test_pos, test_neg], axis=0, ignore_index=True)

    X_train = train_df.iloc[:, 1:-1]
    y_train = train_df["label"]
    X_test  = test_df.iloc[:, 1:-1]
    y_test  = test_df["label"]

    return X_train, X_test, y_train, y_test

# 
